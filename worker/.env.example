# Copy to .env on the TrueNAS box. Never commit .env.

# Console > Environments > truenas-worker > Generate environment key  (sk-ant-oat01-...)
ANTHROPIC_ENVIRONMENT_KEY=
# The environment's ID (env_...), from `ant apply` output / claude-lock.json
ANTHROPIC_ENVIRONMENT_ID=

# Fine-grained PAT, only the repos the agent may work on.
# Repository permissions: Contents RW, Issues RW, Pull requests RW, Metadata R.
GH_TOKEN=

# Identity on the agent's commits
GIT_NAME=Claude Agent
GIT_EMAIL=

WORKER_MEM_LIMIT=16g
