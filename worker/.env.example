# Copy to .env on the TrueNAS box. Never commit .env.

# Console > Environments > truenas-worker > Generate environment key  (sk-ant-oat01-...)
ANTHROPIC_ENVIRONMENT_KEY=
# Console > API keys > Create key (Default workspace). Used only by the dispatcher container.
ANTHROPIC_API_KEY=
# The environment's ID (env_...), from `ant apply` output / claude-lock.json
ANTHROPIC_ENVIRONMENT_ID=

# Fine-grained PAT, only the repos the agent may work on.
# Repository permissions: Contents RW, Issues RW, Pull requests RW, Metadata R.
GH_TOKEN=

# Identity on the agent's commits
GIT_NAME=Claude Agent
GIT_EMAIL=

# The dev box's memory cap, shared by the issue agent's worker (default 48g)
DEVBOX_MEM_LIMIT=48g

# Hard dollar cap per agent session
BUDGET_USD=10

# rfs-ci: the box tests the game repo's pull requests (cloud tasks write the code, the box runs
# tools/test.sh in its slots). 1 turns it on.
DEVBOX_CI=0
# Optional: its own fine-grained PAT, only the game repo. Repository permissions: Commit statuses RW,
# Pull requests RW (for its one comment), Contents R, Metadata R. Empty: it uses GH_TOKEN above,
# which then also needs Commit statuses RW.
CI_GH_TOKEN=
TMD_CI_REPO=derekhearst/TheMerrowDeep
# PR authors whose pull requests it runs by itself (comma separated); anyone else's needs the
# `box: test` label, which only people with triage access can add. Forks never run.
TMD_CI_AUTHORS=derekhearst
